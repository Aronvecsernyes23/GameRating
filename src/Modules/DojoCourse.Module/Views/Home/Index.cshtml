@{
    ViewData["Title"] = "Dojo Course Module";
}

<section class="dc-module-demo">

    <div class="dc-module-badge">
        ORCHARD CORE CUSTOM MODULE
    </div>

    <h1>@ViewData["WelcomeMessage"]</h1>

    <p>
        This page is generated by our custom
        DojoCourse.Module using ASP.NET Core MVC.
    </p>

    <div class="dc-module-features">
        <h2>Implemented Features</h2>

        <ul>
            <li>Custom HomeController</li>
            <li>Razor View</li>
            <li>Dependency Injection</li>
            <li>String Localization</li>
            <li>HTML Localization</li>
            <li>Notifications</li>
            <li>Logging</li>
        </ul>
    </div>

    <form method="post"
          action="@Url.Action("Notify", "Home", new { area = "DojoCourse.Module" })">

        @Html.AntiForgeryToken()

        <button type="submit" class="dc-module-button">
            Test Notification
        </button>
    </form>

    <p class="dc-module-links">
        <a href="@Url.Content("~/games")">
            Browse Games
        </a>

        <a href="@Url.Content("~/submit-a-game")">
            Submit a Game
        </a>
    </p>

</section>
